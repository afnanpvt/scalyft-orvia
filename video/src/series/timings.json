  "ten.hi": {
    "fps": 30,
    "durationInFrames": 682,
    "units": [
      {
        "text": "सुनना चाहते हैं? दस सेकंड में आज़माइए।",
        "start": 0.5,
        "end": 4.298
      },
      {
        "text": "अपने बिज़नेस का प्रकार चुनिए।",
        "start": 4.798,
        "end": 6.415
      },
      {
        "text": "कॉल दबाइए।",
        "start": 6.915,
        "end": 7.614
      },
      {
        "text": "इस एआई असिस्टेंट से वैसे बात कीजिए, जैसे आपका ग्राहक करता।",
        "start": 8.915,
        "end": 13.134
      },
      {
        "text": "देखिए, बुकिंग कैसे बन जाती है।",
        "start": 13.634,
        "end": 15.661
      },
      {
        "text": "साइनअप नहीं। कुछ इंस्टॉल नहीं करना।",
        "start": 16.161,
        "end": 19.209
      },
      {
        "text": "लाइव डेमो आज़माइए।",
        "start": 19.709,
        "end": 21.025
      }
    ]
  },
  "ten.ta": {
    "fps": 30,
    "durationInFrames": 710,
    "units": [
      {
        "text": "கேட்டுப் பார்க்க வேண்டுமா? பத்து வினாடிகளில் முயற்சி செய்யுங்கள்.",
        "start": 0.5,
        "end": 4.336
      },
      {
        "text": "உங்கள் தொழில் வகையைத் தேர்ந்தெடுங்கள்.",
        "start": 4.836,
        "end": 6.564
      },
      {
        "text": "அழைப்பை அழுத்துங்கள்.",
        "start": 7.064,
        "end": 8.111
      },
      {
        "text": "வாடிக்கையாளர் பேசுவது போல, இந்த ஏஐ உதவியாளரிடம் பேசுங்கள்.",
        "start": 9.064,
        "end": 13.097
      },
      {
        "text": "பதிவு எப்படி உருவாகிறது என்று பாருங்கள்.",
        "start": 13.597,
        "end": 15.999
      },
      {
        "text": "பதிவு தேவையில்லை. எதையும் நிறுவ வேண்டாம்.",
        "start": 16.499,
        "end": 19.679
      },
      {
        "text": "நேரலை டெமோவை முயற்சியுங்கள்.",
        "start": 20.179,
        "end": 21.954
      }
    ]
  },
  "ten.te": {
    "fps": 30,
    "durationInFrames": 644,
    "units": [
      {
        "text": "వినాలనుందా? పది సెకన్లలో ప్రయత్నించండి.",
