    "units": [
      {
        "text": "ఒక ఏఐ అసిస్టెంట్. ఎన్నో రకాల వ్యాపారాలు.",
        "start": 0.5,
        "end": 3.928
      },
      {
        "text": "రోగులు ఎదురుచూస్తున్న ఒక క్లినిక్.",
        "start": 4.428,
        "end": 6.257
      },
      {
        "text": "సర్వీస్ జరుగుతున్న ఒక సెలూన్.",
        "start": 6.757,
        "end": 8.468
      },
      {
        "text": "క్లాస్ జరుగుతున్న ఒక కోచింగ్ సెంటర్.",
        "start": 8.968,
        "end": 10.869
      },
      {
        "text": "వేసవి సీజన్‌లో ఒక ఏసీ రిపేర్ షాప్.",
        "start": 11.369,
        "end": 13.616
      },
      {
        "text": "ఓర్వియా ఒక సాఫ్ట్‌వేర్. ప్రతి కాల్‌ని తీసుకుంటుంది.",
        "start": 14.116,
        "end": 17.644
      },
      {
        "text": "మీ వ్యాపారానికి తగ్గట్టుగా సిద్ధం.",
        "start": 18.144,
        "end": 19.984
      },
      {
        "text": "లైవ్ డెమో ప్రయత్నించండి, సైన్అప్ లేదు.",
        "start": 20.484,
        "end": 22.874
      }
    ]
  },
