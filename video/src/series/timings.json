  "niches.ta": {
    "fps": 30,
    "durationInFrames": 784,
    "units": [
      {
        "text": "ஒரு ஏஐ உதவியாளர். பல வகை தொழில்கள்.",
        "start": 0.5,
        "end": 3.635
      },
      {
        "text": "நோயாளிகள் காத்திருக்கும் ஒரு கிளினிக்.",
        "start": 4.136,
        "end": 6.061
      },
      {
        "text": "சேவை நடந்துகொண்டிருக்கும் ஒரு சலூன்.",
        "start": 6.561,
        "end": 8.506
      },
      {
        "text": "வகுப்பு நடந்துகொண்டிருக்கும் ஒரு கோச்சிங் மையம்.",
        "start": 9.006,
        "end": 11.431
      },
      {
        "text": "கோடை காலத்தில் ஒரு ஏசி பழுது பார்க்கும் கடை.",
        "start": 11.931,
        "end": 14.559
      },
      {
        "text": "ஆர்வியா ஒரு மென்பொருள். ஒவ்வொரு அழைப்பையும் எடுக்கும்.",
        "start": 15.059,
        "end": 18.843
      },
      {
        "text": "உங்கள் தொழிலுக்கு ஏற்றவாறு தயார்.",
        "start": 19.343,
        "end": 21.22
      },
      {
        "text": "நேரலை டெமோவை முயற்சியுங்கள், பதிவு இல்லை.",
        "start": 21.72,
        "end": 24.404
      }
    ]
  },
