  "flow.hi": {
    "fps": 30,
    "durationInFrames": 719,
    "units": [
      {
        "text": "एक ग्राहक कॉल करता है।",
        "start": 0.5,
        "end": 1.921
      },
      {
        "text": "ऑरविया, एक एआई असिस्टेंट, तुरंत कॉल उठाता है।",
        "start": 2.5,
        "end": 5.655
      },
      {
        "text": "यह सुनता है और समझता है कि क्या चाहिए।",
        "start": 6.155,
        "end": 8.778
      },
      {
        "text": "यह आपके कैलेंडर में खाली समय देखता है।",
        "start": 9.278,
        "end": 11.826
      },
      {
        "text": "यह स्लॉट बुक कर देता है।",
        "start": 12.326,
        "end": 13.882
      },
      {
        "text": "और कॉल का छोटा सा सारांश लिख देता है।",
        "start": 14.382,
        "end": 16.813
      },
      {
        "text": "सब कुछ आपके डैशबोर्ड में दिखता है।",
        "start": 17.313,
        "end": 19.501
      },
      {
        "text": "लाइव डेमो आज़माइए, साइनअप नहीं।",
        "start": 20.001,
        "end": 22.264
      }
    ]
  },
  "flow.ta": {
    "fps": 30,
    "durationInFrames": 761,
    "units": [
      {
        "text": "ஒரு வாடிக்கையாளர் அழைக்கிறார்.",
        "start": 0.5,
        "end": 2.207
      },
      {
        "text": "ஆர்வியா, ஒரு ஏஐ உதவியாளர், உடனே அழைப்பை எடுக்கிறது.",
        "start": 2.707,
        "end": 6.67
      },
      {
        "text": "அது கேட்டு, என்ன தேவை என்று புரிந்துகொள்கிறது.",
        "start": 7.17,
        "end": 10.037
      },
      {
        "text": "உங்கள் நாட்காட்டியில் காலி நேரத்தைப் பார்க்கிறது.",
        "start": 10.537,
        "end": 13.046
      },
      {
        "text": "அந்த நேரத்தைப் பதிவு செய்கிறது.",
        "start": 13.546,
        "end": 15.188
      },
      {
        "text": "அழைப்பின் சிறு சுருக்கத்தையும் எழுதுகிறது.",
        "start": 15.688,
        "end": 17.932
      },
      {
        "text": "எல்லாமே உங்கள் டாஷ்போர்டில் தெரியும்.",
        "start": 18.432,
        "end": 20.475
      },
      {
        "text": "நேரலை டெமோவை முயற்சியுங்கள், பதிவு இல்லை.",
        "start": 20.975,
        "end": 23.659
      }
    ]
  },
  "flow.te": {
    "fps": 30,
    "durationInFrames": 712,
    "units": [
      {
        "text": "ఒక కస్టమర్ కాల్ చేస్తారు.",
