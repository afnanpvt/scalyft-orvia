  "missed.hi": {
    "fps": 30,
    "durationInFrames": 1056,
    "units": [
      {
        "text": "हर छूटा हुआ कॉल, एक खोया हुआ ग्राहक है।",
        "start": 0.5,
        "end": 3.23
      },
      {
        "text": "भीड़ में छूटा। लंच में छूटा। रात में छूटा।",
        "start": 3.73,
        "end": 8.37
      },
      {
        "text": "ज़्यादातर ग्राहक इंतज़ार नहीं करते। वो अगली दुकान को फ़ोन कर देते हैं।",
        "start": 8.87,
        "end": 14.016
      },
      {
        "text": "मिलिए ऑरविया से, एक एआई वॉइस असिस्टेंट।",
        "start": 14.516,
        "end": 17.253
      },
      {
        "text": "यह सॉफ़्टवेयर है, कोई इंसान नहीं। यह आपके कॉल अपने आप उठाता है।",
        "start": 17.753,
        "end": 23.301
      },
      {
        "text": "यह अपॉइंटमेंट बुक करता है और आपका कैलेंडर भर देता है।",
        "start": 23.801,
        "end": 27.546
      },
      {
        "text": "वही कॉल। अब बुक हुए।",
        "start": 28.046,
        "end": 30.178
      },
      {
        "text": "लाइव डेमो आज़माइए, साइनअप की ज़रूरत नहीं।",
        "start": 30.678,
        "end": 33.467
      }
    ]
  },
  "missed.ta": {
    "fps": 30,
    "durationInFrames": 1072,
    "units": [
      {
        "text": "தவறவிட்ட ஒவ்வொரு அழைப்பும், இழந்த ஒரு வாடிக்கையாளர்.",
        "start": 0.5,
        "end": 3.907
      },
      {
        "text": "நெரிசலில் தவறியது. மதிய உணவில் தவறியது. இரவில் தவறியது.",
        "start": 4.407,
        "end": 9.77
      },
      {
        "text": "பெரும்பாலானோர் காத்திருப்பதில்லை. அடுத்த கடைக்கு அழைத்துவிடுவார்கள்.",
        "start": 10.27,
        "end": 14.608
      },
      {
        "text": "ஆர்வியாவைச் சந்தியுங்கள், ஒரு ஏஐ குரல் உதவியாளர்.",
        "start": 15.108,
        "end": 18.165
      },
      {
        "text": "இது மென்பொருள், மனிதர் அல்ல. உங்கள் அழைப்புகளை தானாகவே எடுக்கும்.",
        "start": 18.665,
        "end": 22.847
      },
      {
        "text": "இது அப்பாயின்ட்மென்ட் பதிவு செய்து, உங்கள் நாட்காட்டியை நிரப்பும்.",
        "start": 23.347,
        "end": 27.035
      },
      {
        "text": "அதே அழைப்புகள். இப்போது பதிவாகின.",
        "start": 27.535,
        "end": 30.504
      },
      {
        "text": "நேரலை டெமோவை முயற்சியுங்கள், பதிவு தேவையில்லை.",
        "start": 31.004,
        "end": 34.005
      }
    ]
  },
  "missed.te": {
    "fps": 30,
    "durationInFrames": 1005,
    "units": [
      {
        "text": "మిస్ అయిన ప్రతి కాల్, కోల్పోయిన ఒక కస్టమర్.",
        "start": 0.5,
        "end": 3.148
      },
      {
        "text": "రద్దీలో మిస్ అయింది. లంచ్‌లో మిస్ అయింది. రాత్రి మిస్ అయింది.",
        "start": 3.648,
        "end": 8.884
      },
      {
        "text": "చాలామంది ఎదురుచూడరు. పక్క షాపుకి ఫోన్ చేస్తారు.",
        "start": 9.384,
        "end": 13.007
      },
      {
        "text": "ఓర్వియాను కలవండి, ఒక ఏఐ వాయిస్ అసిస్టెంట్.",
        "start": 13.507,
        "end": 16.465
      },
      {
        "text": "ఇది సాఫ్ట్‌వేర్, మనిషి కాదు. మీ కాల్స్‌ని దానంతట అదే తీసుకుంటుంది.",
        "start": 16.965,
        "end": 21.94
      },
      {
        "text": "ఇది అపాయింట్‌మెంట్ బుక్ చేసి, మీ క్యాలెండర్‌ని నింపుతుంది.",
        "start": 22.44,
        "end": 25.452
      },
      {
        "text": "అవే కాల్స్. ఇప్పుడు బుక్ అయ్యాయి.",
        "start": 25.952,
        "end": 28.425
      },
      {
        "text": "లైవ్ డెమో ప్రయత్నించండి, సైన్అప్ అవసరం లేదు.",
        "start": 28.925,
        "end": 31.774
      }
    ]
  },
