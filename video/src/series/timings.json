  "niches.hi": {
    "fps": 30,
    "durationInFrames": 779,
    "units": [
      {
        "text": "एक एआई असिस्टेंट। कई तरह के बिज़नेस।",
        "start": 0.5,
        "end": 3.738
      },
      {
        "text": "एक क्लिनिक, जहाँ मरीज़ इंतज़ार में हैं।",
        "start": 4.238,
        "end": 6.521
      },
      {
        "text": "एक सैलून, जहाँ सर्विस चल रही है।",
        "start": 7.021,
        "end": 9.151
      },
      {
        "text": "एक कोचिंग संस्थान, जहाँ क्लास चल रही है।",
        "start": 9.651,
        "end": 12.235
      },
      {
        "text": "एक एसी रिपेयर की दुकान, गर्मियों के सीज़न में।",
        "start": 12.735,
        "end": 15.566
      },
      {
        "text": "ऑरविया एक सॉफ़्टवेयर है, जो हर कॉल उठाता है।",
        "start": 16.066,
        "end": 19.081
      },
      {
        "text": "आपके बिज़नेस के हिसाब से तैयार।",
