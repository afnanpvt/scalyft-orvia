# Sarvam (https://dashboard.sarvam.ai)
SARVAM_API_KEY=

# Shared secret Vapi sends as ?token=... on the bridge URLs. Any long random string.
BRIDGE_TOKEN=

PORT=3001
# "unknown" lets Saaras auto-detect the caller's language. Or pin: kn-IN, te-IN, hi-IN, en-IN
STT_LANGUAGE=unknown
# Bulbul v3 speaker. TTS language is picked per reply from its script.
TTS_SPEAKER=priya

# Only needed for create-assistant.js
VAPI_API_KEY=
# Public https URL of this bridge (ngrok / cloudflared), no trailing slash
PUBLIC_URL=
CLINIC_NAME=Smile Dental Clinic
